{
  "openapi": "3.0.3",
  "info": {
    "title": "School Management API",
    "description": "REST API for School Management System with single-table User architecture (roles: admin, student) and JWT authentication.",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "/school",
      "description": "Local School Management Server"
    }
  ],
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "description": "Enter the JWT token received from POST /login.php or POST /register.php"
      }
    },
    "schemas": {
      "User": {
        "type": "object",
        "properties": {
          "id": { "type": "integer", "example": 1 },
          "name": { "type": "string", "example": "Jane Doe" },
          "email": { "type": "string", "example": "jane@school.com" },
          "role": { "type": "string", "enum": ["admin", "student"], "example": "student" },
          "phone": { "type": "string", "example": "555-0199" },
          "address": { "type": "string", "example": "123 Academic Way" },
          "department": { "type": "string", "example": "Computer Science" },
          "created_at": { "type": "string", "format": "date-time" },
          "updated_at": { "type": "string", "format": "date-time" }
        }
      },
      "LoginRequest": {
        "type": "object",
        "required": ["email", "password"],
        "properties": {
          "email": { "type": "string", "example": "admin@school.com" },
          "password": { "type": "string", "example": "admin123" }
        }
      },
      "RegisterRequest": {
        "type": "object",
        "required": ["name", "email", "password"],
        "properties": {
          "name": { "type": "string", "example": "Harry Potter" },
          "email": { "type": "string", "example": "harry@student.school.com" },
          "password": { "type": "string", "example": "expelliarmus123" },
          "department": { "type": "string", "example": "Grade 10" },
          "phone": { "type": "string", "example": "555-1234" },
          "address": { "type": "string", "example": "4 Privet Drive" }
        }
      },
      "StaffCreateRequest": {
        "type": "object",
        "required": ["name", "email", "password"],
        "properties": {
          "name": { "type": "string", "example": "Albus Dumbledore" },
          "email": { "type": "string", "example": "headmaster@school.com" },
          "password": { "type": "string", "example": "lemonDrop123" },
          "department": { "type": "string", "example": "Administration" },
          "phone": { "type": "string", "example": "555-0001" },
          "address": { "type": "string", "example": "Head Office" }
        }
      },
      "UserUpdateRequest": {
        "type": "object",
        "properties": {
          "name": { "type": "string", "example": "Harry J. Potter" },
          "email": { "type": "string", "example": "harry.potter@student.school.com" },
          "password": { "type": "string", "example": "newPassword123" },
          "department": { "type": "string", "example": "Grade 11" },
          "phone": { "type": "string", "example": "555-9876" },
          "address": { "type": "string", "example": "Godric's Hollow" }
        }
      },
      "ApiResponse": {
        "type": "object",
        "properties": {
          "status": { "type": "string", "example": "success" },
          "message": { "type": "string", "example": "Operation completed successfully" }
        }
      },
      "Application": {
        "type": "object",
        "properties": {
          "id": { "type": "integer", "example": 1 },
          "user_id": { "type": "integer", "example": 4 },
          "qualification": { "type": "string", "example": "High School Diploma" },
          "level": { "type": "string", "example": "Undergraduate Year 1" },
          "profile_pic": { "type": "string", "nullable": true, "example": "uploads/profile_pics/sample.jpg" },
          "certificate": { "type": "string", "nullable": true, "example": "uploads/certificates/sample.pdf" },
          "status": { "type": "string", "enum": ["pending", "approved", "rejected"], "example": "pending" },
          "admin_comment": { "type": "string", "nullable": true, "example": "Qualifications verified and accepted." },
          "reviewed_by": { "type": "integer", "nullable": true, "example": 1 },
          "reviewed_at": { "type": "string", "format": "date-time", "nullable": true },
          "created_at": { "type": "string", "format": "date-time" },
          "student_name": { "type": "string", "example": "Ron Weasley" },
          "student_email": { "type": "string", "example": "ron@student.school.com" },
          "reviewer_name": { "type": "string", "nullable": true, "example": "System Administrator" }
        }
      },
      "ApplicationSubmitRequest": {
        "type": "object",
        "required": ["qualification", "level"],
        "properties": {
          "qualification": { "type": "string", "example": "High School Diploma" },
          "level": { "type": "string", "example": "Undergraduate Year 1" },
          "profile_pic": { "type": "string", "format": "binary", "description": "Profile picture upload" },
          "certificate": { "type": "string", "format": "binary", "description": "Certificate document upload (PDF/Image)" }
        }
      },
      "ApplicationReviewRequest": {
        "type": "object",
        "required": ["status"],
        "properties": {
          "status": { "type": "string", "enum": ["approved", "rejected"], "example": "approved" },
          "admin_comment": { "type": "string", "example": "Qualifications verified. Welcome to school!" }
        }
      },
      "PasswordResetRequest": {
        "type": "object",
        "required": ["email"],
        "properties": {
          "email": { "type": "string", "example": "admin@school.com" }
        }
      },
      "PasswordResetConfirmRequest": {
        "type": "object",
        "required": ["token", "password"],
        "properties": {
          "token": { "type": "string", "example": "dcf1c8a86ab4bcc4c52e6d35e099d3f922ef056bbe5d45a68d49417373961aa3" },
          "password": { "type": "string", "example": "newPassword123" },
          "confirm_password": { "type": "string", "example": "newPassword123" }
        }
      }
    }
  },
  "paths": {
    "/login.php": {
      "post": {
        "summary": "User Login",
        "description": "Authenticates user (admin or student) and returns a signed JWT token.",
        "tags": ["Authentication"],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/LoginRequest" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Login successful. Returns JWT token.",
            "content": {
              "application/json": {
                "example": {
                  "status": "success",
                  "message": "Login successful",
                  "token": "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...",
                  "user": {
                    "id": 1,
                    "name": "System Administrator",
                    "email": "admin@school.com",
                    "role": "admin"
                  }
                }
              }
            }
          },
          "400": { "description": "Email and password are required" },
          "401": { "description": "Invalid email or password" }
        }
      }
    },
    "/register.php": {
      "post": {
        "summary": "Student Registration",
        "description": "Public registration endpoint for students. Creates a user with role='student' and immediately returns a JWT token.",
        "tags": ["Authentication"],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/RegisterRequest" }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Student registered successfully. Returns JWT token.",
            "content": {
              "application/json": {
                "example": {
                  "status": "success",
                  "message": "Student registered successfully",
                  "token": "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...",
                  "user": {
                    "id": 2,
                    "name": "Harry Potter",
                    "email": "harry@student.school.com",
                    "role": "student"
                  }
                }
              }
            }
          },
          "400": { "description": "Validation error or email already registered" }
        }
      }
    },
    "/profile.php": {
      "get": {
        "summary": "View User Profile",
        "description": "Fetches profile. Students can only view their own profile. Admins can view their own profile or any user's profile by supplying `?id={id}`.",
        "tags": ["Profile"],
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          {
            "name": "id",
            "in": "query",
            "required": false,
            "description": "Target user ID (Admin only)",
            "schema": { "type": "integer" }
          }
        ],
        "responses": {
          "200": {
            "description": "Profile data retrieved",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": { "type": "string", "example": "success" },
                    "data": { "$ref": "#/components/schemas/User" }
                  }
                }
              }
            }
          },
          "401": { "description": "Unauthorized - Missing or invalid Bearer token" },
          "403": { "description": "Forbidden - Students attempting to access another user's profile" },
          "404": { "description": "Profile not found" }
        }
      },
      "put": {
        "summary": "Update User Profile",
        "description": "Updates profile. Students can only update their own profile. Admins can update any user.",
        "tags": ["Profile"],
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          {
            "name": "id",
            "in": "query",
            "required": false,
            "description": "Target user ID (Admin only)",
            "schema": { "type": "integer" }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/UserUpdateRequest" }
            }
          }
        },
        "responses": {
          "200": { "description": "Profile updated successfully" },
          "401": { "description": "Unauthorized" },
          "403": { "description": "Forbidden - Students cannot update others' profiles" },
          "400": { "description": "Invalid input data" }
        }
      }
    },
    "/staff.php": {
      "get": {
        "summary": "List or Fetch Staff (Admin Full Access)",
        "description": "Retrieves all staff members (role='admin') or a specific staff member by ID. Access denied (403) for students.",
        "tags": ["Staff (Admin Only)"],
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          {
            "name": "id",
            "in": "query",
            "required": false,
            "description": "Staff ID to retrieve",
            "schema": { "type": "integer" }
          }
        ],
        "responses": {
          "200": { "description": "Staff list or details" },
          "401": { "description": "Unauthorized" },
          "403": { "description": "Forbidden: Requires Admin role" },
          "404": { "description": "Staff member not found" }
        }
      },
      "post": {
        "summary": "Add New Staff Member",
        "description": "Creates a new staff member with role='admin'. Admin only.",
        "tags": ["Staff (Admin Only)"],
        "security": [{ "bearerAuth": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/StaffCreateRequest" }
            }
          }
        },
        "responses": {
          "201": { "description": "Staff member created" },
          "400": { "description": "Validation error" },
          "401": { "description": "Unauthorized" },
          "403": { "description": "Forbidden: Requires Admin role" }
        }
      },
      "put": {
        "summary": "Update Staff Member",
        "description": "Updates a staff member's profile. Admin only.",
        "tags": ["Staff (Admin Only)"],
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          {
            "name": "id",
            "in": "query",
            "required": true,
            "description": "Staff ID to update",
            "schema": { "type": "integer" }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/UserUpdateRequest" }
            }
          }
        },
        "responses": {
          "200": { "description": "Staff profile updated" },
          "400": { "description": "Invalid input" },
          "401": { "description": "Unauthorized" },
          "403": { "description": "Forbidden: Requires Admin role" },
          "404": { "description": "Staff member not found" }
        }
      },
      "delete": {
        "summary": "Delete Staff Member",
        "description": "Deletes a staff member. Admin only. Active admin cannot delete their own account.",
        "tags": ["Staff (Admin Only)"],
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          {
            "name": "id",
            "in": "query",
            "required": true,
            "description": "Staff ID to delete",
            "schema": { "type": "integer" }
          }
        ],
        "responses": {
          "200": { "description": "Staff member deleted" },
          "400": { "description": "Cannot delete active admin account" },
          "401": { "description": "Unauthorized" },
          "403": { "description": "Forbidden: Requires Admin role" },
          "404": { "description": "Staff member not found" }
        }
      }
    },
    "/students.php": {
      "get": {
        "summary": "Fetch Students",
        "description": "Admin receives full list of all students or student by ID. Students only receive their own profile (owned access).",
        "tags": ["Students"],
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          {
            "name": "id",
            "in": "query",
            "required": false,
            "description": "Student ID to retrieve (Admin can view any; Student can only view self)",
            "schema": { "type": "integer" }
          }
        ],
        "responses": {
          "200": { "description": "Student list or single student" },
          "401": { "description": "Unauthorized" },
          "403": { "description": "Forbidden: Student attempting to view another student" },
          "404": { "description": "Student not found" }
        }
      },
      "post": {
        "summary": "Add or Register Student",
        "description": "Registers a new student. Can be called publicly (returns JWT) or by an authenticated Admin.",
        "tags": ["Students"],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/RegisterRequest" }
            }
          }
        },
        "responses": {
          "201": { "description": "Student created/registered" },
          "400": { "description": "Validation error" }
        }
      },
      "put": {
        "summary": "Update Student Profile",
        "description": "Updates student profile. Admins can update any student. Students can ONLY update their own profile.",
        "tags": ["Students"],
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          {
            "name": "id",
            "in": "query",
            "required": false,
            "description": "Student ID to update",
            "schema": { "type": "integer" }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/UserUpdateRequest" }
            }
          }
        },
        "responses": {
          "200": { "description": "Student profile updated" },
          "401": { "description": "Unauthorized" },
          "403": { "description": "Forbidden: Cannot update other students" },
          "404": { "description": "Student not found" }
        }
      },
      "delete": {
        "summary": "Delete Student (Admin Only)",
        "description": "Deletes a student record. Admin only! Students receive 403 Forbidden.",
        "tags": ["Students"],
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          {
            "name": "id",
            "in": "query",
            "required": true,
            "description": "Student ID to delete",
            "schema": { "type": "integer" }
          }
        ],
        "responses": {
          "200": { "description": "Student deleted" },
          "401": { "description": "Unauthorized" },
          "403": { "description": "Forbidden: Only admins can delete students" },
          "404": { "description": "Student not found" }
        }
      }
    },
    "/applications.php": {
      "get": {
        "summary": "View Applications or Application Status",
        "description": "Students view their own application and its status (pending/approved/rejected). Admins view all applications with optional ?status=pending|approved|rejected filter, or ?id={id} for full details.",
        "tags": ["Applications"],
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          {
            "name": "id",
            "in": "query",
            "required": false,
            "description": "Application ID (Students can only view own; Admins can view any)",
            "schema": { "type": "integer" }
          },
          {
            "name": "status",
            "in": "query",
            "required": false,
            "description": "Filter by status: pending, approved, rejected (Admin only)",
            "schema": { "type": "string", "enum": ["pending", "approved", "rejected"] }
          }
        ],
        "responses": {
          "200": {
            "description": "Application data or list retrieved",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": { "type": "string", "example": "success" },
                    "data": {
                      "type": "array",
                      "items": { "$ref": "#/components/schemas/Application" }
                    }
                  }
                }
              }
            }
          },
          "401": { "description": "Unauthorized" },
          "403": { "description": "Forbidden: Students attempting to view another student's application" },
          "404": { "description": "Application not found" }
        }
      },
      "post": {
        "summary": "Submit Student Application",
        "description": "Student submits admission application with qualification, level, profile picture, and certificate. Supports multipart/form-data for file uploads.",
        "tags": ["Applications"],
        "security": [{ "bearerAuth": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "multipart/form-data": {
              "schema": { "$ref": "#/components/schemas/ApplicationSubmitRequest" }
            },
            "application/json": {
              "schema": { "$ref": "#/components/schemas/ApplicationSubmitRequest" }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Application submitted successfully with pending status",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": { "type": "string", "example": "success" },
                    "message": { "type": "string", "example": "Application submitted successfully. Status is pending review." },
                    "data": { "$ref": "#/components/schemas/Application" }
                  }
                }
              }
            }
          },
          "400": { "description": "Validation error: missing qualification or level, or invalid file type" },
          "401": { "description": "Unauthorized" }
        }
      },
      "put": {
        "summary": "Review Application (Admin Accept / Reject)",
        "description": "Admin approves or rejects an application with optional comments. Students receive 403 Forbidden.",
        "tags": ["Applications"],
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          {
            "name": "id",
            "in": "query",
            "required": true,
            "description": "Application ID to review",
            "schema": { "type": "integer" }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/ApplicationReviewRequest" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Application status updated successfully",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": { "type": "string", "example": "success" },
                    "message": { "type": "string", "example": "Application status updated to 'approved'" },
                    "data": { "$ref": "#/components/schemas/Application" }
                  }
                }
              }
            }
          },
          "400": { "description": "Missing status or invalid value" },
          "401": { "description": "Unauthorized" },
          "403": { "description": "Forbidden: Only administrators can approve or reject applications" },
          "404": { "description": "Application not found" }
        }
      },
      "delete": {
        "summary": "Delete Application",
        "description": "Deletes an application and removes associated uploaded files. Admin can delete any; students can delete pending only.",
        "tags": ["Applications"],
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          {
            "name": "id",
            "in": "query",
            "required": true,
            "description": "Application ID to delete",
            "schema": { "type": "integer" }
          }
        ],
        "responses": {
          "200": { "description": "Application deleted successfully" },
          "401": { "description": "Unauthorized" },
          "403": { "description": "Forbidden" },
          "404": { "description": "Application not found" }
        }
      }
    },
    "/password_reset.php": {
      "post": {
        "summary": "Request Password Reset (Send Email) or Confirm Reset",
        "description": "Send a JSON payload with `email` to request a reset token via email. Or send `token` and `password` (and optional `action: confirm`) to confirm password reset and update your password.",
        "tags": ["Password Reset"],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "oneOf": [
                  { "$ref": "#/components/schemas/PasswordResetRequest" },
                  { "$ref": "#/components/schemas/PasswordResetConfirmRequest" }
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Reset token generated/emailed OR password successfully reset",
            "content": {
              "application/json": {
                "example": {
                  "status": "success",
                  "message": "Password has been successfully updated! You can now log in with your new password."
                }
              }
            }
          },
          "400": { "description": "Validation error or token expired/invalid" },
          "404": { "description": "User email not found" }
        }
      },
      "get": {
        "summary": "Verify Password Reset Token",
        "description": "Verifies if a reset token is valid, unused, and within the 1-hour expiration window. (If visited in browser, displays HTML password reset form).",
        "tags": ["Password Reset"],
        "parameters": [
          {
            "name": "token",
            "in": "query",
            "required": true,
            "description": "The 64-character token received via email or reset request",
            "schema": { "type": "string" }
          }
        ],
        "responses": {
          "200": {
            "description": "Token is valid",
            "content": {
              "application/json": {
                "example": {
                  "status": "success",
                  "valid": true,
                  "message": "Token is valid",
                  "email": "user@school.com",
                  "expires_at": "2026-10-05 17:30:00"
                }
              }
            }
          },
          "400": { "description": "Token is invalid, expired, or already used" }
        }
      }
    }
  }
}
